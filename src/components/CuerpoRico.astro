---
import { imageUrl } from '../lib/content';
import { agruparCuerpo } from '../lib/portable';
import type { Bloque } from '../lib/types';

// Pinta el texto enriquecido del panel: párrafos, títulos, listas, citas y las
// fotos intercaladas entre ellos.
const { bloques = [] } = Astro.props as { bloques?: Bloque[] };
const groups = agruparCuerpo(bloques.filter((block) => block._type !== 'foto' || Boolean(block.url)));
---
{groups.map((group) =>
  group.tipo === 'foto' ? (
    <figure class="photo-box">
      <img src={imageUrl({ url: group.bloque.url, alt: group.bloque.alt })} alt={group.bloque.alt} loading="lazy" />
    </figure>
  ) : group.tipo === 'lista' ? (
    group.ordenada ? (
      <ol>{group.items.map((html) => <li set:html={html} />)}</ol>
    ) : (
      <ul>{group.items.map((html) => <li set:html={html} />)}</ul>
    )
  ) : group.etiqueta === 'h2' ? (
    <h2 set:html={group.html} />
  ) : group.etiqueta === 'h3' ? (
    <h3 set:html={group.html} />
  ) : group.etiqueta === 'blockquote' ? (
    <blockquote set:html={group.html} />
  ) : (
    <p set:html={group.html} />
  ),
)}
