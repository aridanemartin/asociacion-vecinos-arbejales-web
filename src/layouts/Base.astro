---
import '../styles/global.css';
import { site, nav, developer } from '../data/site';
const { title, description = site.description } = Astro.props as { title?: string; description?: string };
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.place}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/img/logo-simbolo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="/">
          <img src="/img/logo-simbolo.png" alt={`${site.name}: ir al inicio`} width="256" height="256" />
          <img class="brand-letras" src="/img/logo-letras-blanco.webp" alt="" width="834" height="201" />
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir menú">
          <span></span><span></span><span></span>
        </button>
        <nav class="main-nav" id="menu-principal" aria-label="Secciones" data-open="false">
          <div class="container">
            <ul>
              <li style="--i:0">
                <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
                  <span class="nav-short">Inicio</span>
                  <span class="nav-long">Inicio</span>
                </a>
              </li>
              {nav.map((n, i) => (
                <li style={`--i:${i + 1}`}>
                  <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>
                    <span class="nav-short">{n.short}</span>
                    <span class="nav-long">{n.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="funders">
          <p>Página financiada por:</p>
          <img src="/img/cabildo-gran-canaria.jpg" alt="Cabildo de Gran Canaria" width="400" height="393" loading="lazy" />
        </div>
        <p class="footer-meta">© {new Date().getFullYear()} {site.name} · {site.place}</p>
      </div>
    </footer>
    <p class="credit">
      Página web desarrollada por{' '}
      <a href={developer.url} target="_blank" rel="noopener noreferrer">{developer.name}<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
      {' '}· {developer.year}
    </p>
    <script is:inline>
      (function () {
        var btn = document.querySelector('.nav-toggle');
        var menu = document.getElementById('menu-principal');
        if (!btn || !menu) return;
        var mq = window.matchMedia('(max-width: 62rem)');
        var behind = document.querySelectorAll('main, .site-footer, .credit, .skip-link');

        function setOpen(open) {
          if (open) {
            // El círculo del menú nace en el botón.
            var r = btn.getBoundingClientRect();
            menu.style.setProperty('--ox', r.left + r.width / 2 + 'px');
            menu.style.setProperty('--oy', r.top + r.height / 2 + 'px');
          }
          menu.dataset.open = String(open);
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
          document.documentElement.classList.toggle('menu-open', open);
          behind.forEach(function (el) { el.inert = open; });
          if (open) {
            var first = menu.querySelector('a');
            if (first) setTimeout(function () { first.focus({ preventScroll: true }); }, 50);
          }
        }

        btn.addEventListener('click', function () {
          setOpen(btn.getAttribute('aria-expanded') !== 'true');
        });
        menu.addEventListener('click', function (e) {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
        });
        mq.addEventListener('change', function () { setOpen(false); });
      })();
    </script>
  </body>
</html>
