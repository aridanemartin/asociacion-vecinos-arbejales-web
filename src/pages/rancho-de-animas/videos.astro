---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getVideos } from '../../lib/content';
const videos = await getVideos();
---
<Base title="Vídeos del Rancho de Ánimas">
  <PageHead title="Vídeos del Rancho de Ánimas" trail={[{ href: '/rancho-de-animas', label: 'Rancho de Ánimas' }]} />
  <div class="container section">
    {videos.length === 0 ? (
      <p class="empty">Todavía no hay vídeos publicados.</p>
    ) : (
      <div class="grid">
        {videos.map((v) => (
          <figure class="card" style="margin:0">
            <iframe style="width:100%;aspect-ratio:16/9;border:0" src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`} title={v.titulo} loading="lazy" allowfullscreen></iframe>
            <figcaption style="padding:16px">{v.titulo}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</Base>
