---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CuerpoRico from '../../components/CuerpoRico.astro';
import { getRancho, getVideos } from '../../lib/content';
const r = await getRancho();
const videos = await getVideos();
---
<Base title="Rancho de Ánimas Arbejales" description="Historia y vídeos del Rancho de Ánimas de Arbejales, en Teror.">
  <PageHead title="Rancho de Ánimas Arbejales" intro="Una tradición viva del barrio." />
  <div class="container section">
    <section class="rancho-historia" aria-labelledby="historia-titulo">
      <h2 id="historia-titulo">Historia</h2>
      <div class="prose historia">
        {r?.cuerpo?.length ? (
          <CuerpoRico bloques={r.cuerpo} />
        ) : (
          <p class="empty">Pronto publicaremos aquí la historia del Rancho de Ánimas.</p>
        )}
      </div>
    </section>

    <section class="rancho-videos" aria-labelledby="videos-titulo">
      <h2 id="videos-titulo">Vídeos</h2>
      {videos.length === 0 ? (
        <p class="empty">Todavía no hay vídeos publicados.</p>
      ) : (
        <div class="video-grid">
          {videos.map((v) => (
            <figure class="card video-card">
              <div class="video-frame">
                <a class="video-play" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener noreferrer" aria-label={`Ver en YouTube: ${v.titulo} (se abre en una pestaña nueva)`}>
                  <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
                </a>
              </div>
              <figcaption>{v.titulo.replace(/^Rancho de Ánimas de Arbejales-Teror[,:]?\s*/, '') || v.titulo}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .rancho-historia { max-width: 46rem; margin-inline: auto; }
  .rancho-videos { margin-top: var(--space-12); }
  .rancho-videos h2 { margin-bottom: var(--space-4); }
  .video-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .video-card { margin: 0; }
  .video-frame { position: relative; aspect-ratio: 16 / 9; background: #000; }
  .video-play, .video-play img { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-play { padding: 0; cursor: pointer; background: #000; display: block; }
  .video-play:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -3px; }
  .video-play img { object-fit: cover; }
  .video-play::before { content: ''; position: absolute; z-index: 1; top: 50%; left: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: rgb(174 53 40 / 0.92); box-shadow: 0 2px 10px rgb(0 0 0 / 0.35); transition: transform 150ms var(--ease); }
  .video-play::after { content: ''; position: absolute; z-index: 1; top: 50%; left: 50%; margin: -12px 0 0 -10px; border-left: 20px solid #fff; border-top: 12px solid transparent; border-bottom: 12px solid transparent; }
  .video-play:hover::before { transform: scale(1.08); }
  .video-card figcaption { padding: var(--space-3) var(--space-4) var(--space-4); font-weight: 600; font-size: 0.95rem; line-height: 1.4; }
</style>
