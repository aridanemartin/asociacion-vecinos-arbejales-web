---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { folders, getFiles } from '../../lib/content';
export function getStaticPaths() {
  return folders.map((folder) => ({ params: { carpeta: folder.slug }, props: { folder } }));
}
const { folder } = Astro.props;
const files = await getFiles(folder.slug);
---
<Base title={folder.title}>
  <PageHead title={folder.title} intro={folder.description} />
  <div class="container section">
    {files.length === 0 ? (
      <p class="empty">Todavía no hay archivos en esta carpeta.</p>
    ) : (
      <ul class="file-list">
        {files.map((file) => (
          <li>
            <a class="card" href={file.url} download={file.nombre} target="_blank" rel="noopener noreferrer">
              <Icon name="file" /> <span>{file.titulo}</span>
              {file.fecha && <time datetime={file.fecha}>{file.fecha}</time>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
