---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { getChurch, imageUrl, splitLines } from '../lib/content';
const church = await getChurch();
const schedules = [
  { title: 'Horario de misas', lines: splitLines(church?.horarioMisas), contact: church?.contactoMisas },
  { title: 'Horario del cementerio', lines: splitLines(church?.horarioCementerio), contact: church?.contactoCementerio },
  { title: 'Horario del archivo parroquial', lines: splitLines(church?.horarioArchivo), contact: church?.contactoArchivo },
];
// The first photo from Sanity; if there is none, the old photo of the church.
const photo = church?.fotos[0] ?? {
  url: '/img/iglesia-historica.webp',
  alt: 'Fotografía antigua de la iglesia de Arbejales, rodeada de terrenos de cultivo y montañas',
};
---
<Base title="Iglesia y cementerio" description="Horarios de misas, cementerio y archivo parroquial de Arbejales.">
  <PageHead title="Iglesia y cementerio" intro="Horarios y fotografías de la iglesia y el cementerio de Arbejales." />
  <div class="container section">
    <div class="two-col iglesia-grid">
    <dl class="schedule">
      {schedules.map((schedule) => (
        <div class="card">
          <dt>{schedule.title}</dt>
          <dd>{schedule.lines.length ? schedule.lines.map((line) => <span style="display:block">{line}</span>) : 'Por confirmar'}</dd>
          {(schedule.contact?.telefono || schedule.contact?.email) && (
            <dd class="horario-contacto">
              {schedule.contact.responsable && <span class="responsable">{schedule.contact.responsable}</span>}
              {schedule.contact.telefono && (
                <a href={`tel:${schedule.contact.telefono.replace(/\s/g, '')}`}>
                  <Icon name="phone" size={18} />
                  <span class="sr-only">Llamar: </span>{schedule.contact.telefono}
                </a>
              )}
              {schedule.contact.email && (
                <a href={`mailto:${schedule.contact.email}`}>
                  <Icon name="mail" size={18} />
                  <span><span class="sr-only">Escribir a: </span>{schedule.contact.email}</span>
                </a>
              )}
            </dd>
          )}
        </div>
      ))}
    </dl>
    <div class="iglesia-foto">
      <img src={imageUrl(photo, 1000)} alt={photo.alt} loading="lazy" />
    </div>
    </div>
  </div>
</Base>
<style>
  .iglesia-grid > * { min-width: 0; }
  .iglesia-foto { border-radius: var(--radius); overflow: hidden; }
  /* En móvil la foto conserva su forma; si es muy vertical se recorta por abajo. */
  .iglesia-foto img { display: block; width: 100%; height: auto; max-height: 34rem; object-fit: cover; object-position: center top; }
  .schedule > div { flex-direction: column; justify-content: flex-start; gap: var(--space-1); }
  .horario-contacto { display: flex; flex-direction: column; gap: var(--space-1); margin-top: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--color-border); }
  .horario-contacto .responsable { font-size: 0.9rem; }
  .horario-contacto a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .horario-contacto a > span { min-width: 0; overflow-wrap: anywhere; }
  .horario-contacto a:hover { text-decoration: underline; }
  @media (min-width: 56rem) {
    .iglesia-grid { align-items: stretch; grid-template-columns: 1fr 1fr; }
    .iglesia-foto { position: relative; min-height: 24rem; }
    .iglesia-foto img { position: absolute; inset: 0; height: 100%; max-height: none; }
  }
</style>
