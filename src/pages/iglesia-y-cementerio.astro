---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getIglesia, lineas } from '../lib/content';
const i = await getIglesia();
const horarios = [
  { titulo: 'Horario de misas', lineas: lineas(i?.horarioMisas) },
  { titulo: 'Horario del cementerio', lineas: lineas(i?.horarioCementerio) },
  { titulo: 'Horario del archivo parroquial', lineas: lineas(i?.horarioArchivo) },
];
---
<Base title="Iglesia y cementerio" description="Horarios de misas, cementerio y archivo parroquial de Arbejales.">
  <PageHead title="Iglesia y cementerio" intro="Horarios y fotografías de la iglesia y el cementerio de Arbejales." />
  <div class="container section">
    <div class="two-col iglesia-grid">
    <dl class="schedule">
      {horarios.map((h) => (
        <div class="card">
          <dt>{h.titulo}</dt>
          <dd>{h.lineas.length ? h.lineas.map((l) => <span style="display:block">{l}</span>) : 'Por confirmar'}</dd>
        </div>
      ))}
    </dl>
    <div class="iglesia-foto">
      <img src="/img/iglesia-historica.webp" alt="Fotografía antigua de la iglesia de Arbejales, rodeada de terrenos de cultivo y montañas" width="1200" height="860" loading="lazy" />
    </div>
    </div>
  </div>
</Base>
<style>
  .iglesia-foto { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; }
  .iglesia-foto img { width: 100%; height: 100%; object-fit: cover; }
  .schedule > div { flex-direction: column; justify-content: flex-start; gap: var(--space-1); }
  @media (min-width: 56rem) {
    .iglesia-grid { align-items: stretch; grid-template-columns: 1fr 1fr; }
    .iglesia-foto { position: relative; aspect-ratio: auto; }
    .iglesia-foto img { position: absolute; inset: 0; }
  }
</style>
