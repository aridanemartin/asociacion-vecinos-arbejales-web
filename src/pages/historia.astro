---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CuerpoRico from '../components/CuerpoRico.astro';
import { getHistory } from '../lib/content';
const history = await getHistory();
---
<Base title="Historia de Arbejales" description="Textos, historias y fotos sobre la historia del barrio de Arbejales, en Teror.">
  <PageHead title="Historia de Arbejales" intro="El barrio de Arbejales y sus gentes" />
  <div class="container section">
    <div class="prose historia">
      <CuerpoRico bloques={history?.cuerpo} />
    </div>
  </div>
</Base>
