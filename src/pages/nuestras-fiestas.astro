---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CuerpoRico from '../components/CuerpoRico.astro';
import Gallery from '../components/Gallery.astro';
import { getFestivities, getFestivityYears } from '../lib/content';
const festivities = await getFestivities();
const years = (await getFestivityYears()).filter((year) => year.fotos.length > 0);
---
<Base title="Nuestras fiestas" description="Cómo celebramos las fiestas de Arbejales, en Teror, y fotos de años anteriores.">
  <PageHead title="Nuestras fiestas" intro="Las fiestas del barrio y las fotos de las ediciones anteriores." />
  <div class="container section">
    <div class="prose historia">
      {festivities?.cuerpo?.length ? (
        <CuerpoRico bloques={festivities.cuerpo} />
      ) : (
        <p class="empty">Pronto publicaremos aquí la descripción de nuestras fiestas.</p>
      )}
    </div>

    <section class="fiestas-fotos" aria-labelledby="fotos-anios-titulo">
      <h2 id="fotos-anios-titulo">Fotos de años anteriores</h2>
      {years.length === 0 ? (
        <p class="empty">Pronto publicaremos aquí las fotos de las fiestas de otros años.</p>
      ) : (
        <>
          <div class="year-tabs" role="tablist" aria-label="Año de las fotos" hidden>
            {years.map((year, index) => (
              <button class="year-link" type="button" role="tab" id={`tab-${year.anio}`} aria-controls={`fiestas-${year.anio}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{year.anio}</button>
            ))}
          </div>
          {years.map((year) => (
            <section class="year-block" id={`fiestas-${year.anio}`} role="tabpanel" aria-labelledby={`tab-${year.anio}`}>
              <h3>Fiestas de {year.anio}</h3>
              <Gallery fotos={year.fotos} />
            </section>
          ))}
        </>
      )}
    </section>
  </div>
</Base>

<script>
  // Shows one year's photos at a time; without JavaScript all years are shown.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.year-tabs [role="tab"]'));
  const tabList = document.querySelector<HTMLElement>('.year-tabs');
  if (tabList && tabs.length) {
    tabList.hidden = false;
    const show = (tab: HTMLButtonElement, focus = false) => {
      for (const current of tabs) {
        const isActive = current === tab;
        current.setAttribute('aria-selected', String(isActive));
        current.tabIndex = isActive ? 0 : -1;
        const panel = document.getElementById(current.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !isActive;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab) => tab.addEventListener('click', () => show(tab)));
    tabList.addEventListener('keydown', (event) => {
      const index = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        show(tabs[event.key === 'Home' ? 0 : tabs.length - 1], true);
      } else if (step) {
        event.preventDefault();
        show(tabs[(index + step + tabs.length) % tabs.length], true);
      }
    });
    const fromHash = tabs.find((tab) => `#${tab.getAttribute('aria-controls')}` === location.hash);
    show(fromHash ?? tabs[0]);
  }
</script>

<style>
  .fiestas-fotos { margin-top: var(--space-12); }
  .year-tabs { margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .year-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); border-radius: 999px; border: 1.5px solid var(--color-primary); color: var(--color-primary); font-weight: 600; background: none; font-size: inherit; cursor: pointer; }
  .year-link[aria-selected='true'] { background: var(--color-primary); color: var(--color-on-accent); }
  .year-link:hover { background: var(--color-primary); color: var(--color-on-accent); }
  .year-block { margin-top: var(--space-8); scroll-margin-top: var(--space-6); }
  .year-block h3 { margin-bottom: var(--space-4); }
  .year-block[hidden], .year-tabs[hidden] { display: none; }
</style>
