---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../data/site';
import { getNovedades, imgUrl } from '../lib/content';
const novedades = await getNovedades();
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base>
  <section class="hero" aria-label="Arbejales, Teror">
    <img
      class="hero-bg"
      src="/img/hero-fuegos.webp"
      alt="Fuegos artificiales sobre la iglesia de Arbejales durante las fiestas, de noche"
      width="2000"
      height="1259"
      fetchpriority="high"
    />
    <div class="hero-logo">
      <img src="/img/logo-completo-texto-blanco.webp" alt="Arbejales, un pueblo con corazón" width="1000" height="833" />
    </div>
  </section>

  <section class="section" aria-labelledby="asociacion-titulo">
    <div class="container">
      <div class="two-col intro-asociacion">
        <div class="prose">
          <h1 id="asociacion-titulo">Asociación de vecinos Llano Roque - Arbejales</h1>
          <p>
            La Asociación de vecinos Llano Roque - Arbejales (antes San Marcos) fue constituida en 1977 por un grupo
            de vecinos de Arbejales con el objeto de luchar por mejoras para el barrio, mantener sus tradiciones y
            fomentar la unión vecinal.
          </p>
          <p>
            Actualmente su presidente es D. Jose Vicente Montesdeoca Rivero, el número de socios es de unos 150, y tras
            medio siglo de existencia, mantiene la misma vocación de servicio a nuestros socios y a Arbejales.
          </p>
          <p>
            Su local social se encuentra en la calle Juan Quintana Quintana, n.º 8, Arbejales (Teror).
          </p>
        </div>
        <figure class="intro-foto">
          <img
            src="/img/iglesia-arbejales.webp"
            alt="Iglesia de Arbejales engalanada con banderines y flores durante las fiestas del barrio"
            width="1400"
            height="934"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section aria-labelledby="novedades-titulo">
    <div class="container">
      <div class="carousel-head">
        <h2 id="novedades-titulo">Noticias, eventos y convocatorias</h2>
        <div class="carousel-controls">
          <button class="icon-btn" type="button" data-dir="-1" aria-label="Anteriores"><Icon name="prev" /></button>
          <button class="icon-btn" type="button" data-dir="1" aria-label="Siguientes"><Icon name="next" /></button>
        </div>
      </div>
      {novedades.length === 0 && <p class="empty">Pronto publicaremos aquí las noticias, eventos y convocatorias de la asociación.</p>}
      <ul class="carousel" id="carrusel" style="list-style:none;margin:0;padding:0 0 12px" tabindex="0" aria-label="Lista de noticias, eventos y convocatorias, desplazable">
        {novedades.map((n) => (
          <li class="card news">
            <div class="news-media">
              {n.foto ? (
                <img src={imgUrl(n.foto, 800)} alt={n.foto.alt} loading="lazy" width="640" height="400" />
              ) : (
                <img src="/img/arbejales-placeholder.webp" alt="" loading="lazy" width="640" height="427" />
              )}
            </div>
            <div class="news-body">
              <span class="tag" data-kind={n.etiqueta}>{n.etiqueta}</span>
              <h3>{n.enlace ? <a href={n.enlace}>{n.titulo}</a> : n.titulo}</h3>
              <time datetime={n.fecha}>{fmt.format(new Date(n.fecha))}</time>
              <p>{n.resumen}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="secciones-titulo">
    <div class="container">
      <h2 id="secciones-titulo">¿Qué buscas?</h2>
      <div class="grid">
        {nav.map((n) => (
          <a class="card tile" href={n.href}>
            <span class="ico"><Icon name={n.icon} /></span>
            <h3>{n.label}</h3>
            <p>{n.blurb}</p>
            <span class="more">Entrar <Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var c = document.getElementById('carrusel');
      document.querySelectorAll('[data-dir]').forEach(function (b) {
        b.addEventListener('click', function () {
          var step = c.firstElementChild ? c.firstElementChild.getBoundingClientRect().width + 16 : 300;
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          c.scrollBy({ left: Number(b.dataset.dir) * step, behavior: reduce ? 'auto' : 'smooth' });
        });
      });
    })();
  </script>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(380px, 62vh, 620px);
    padding: var(--space-8) var(--space-4);
    overflow: hidden;
    background: var(--color-foreground);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
  }
  .hero-logo {
    position: relative;
    z-index: 1;
  }
  .hero-logo img {
    display: block;
    width: clamp(180px, 30vw, 320px);
    height: auto;
  }
  .intro-foto {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 2;
    box-shadow: var(--shadow);
  }
  .intro-foto img { width: 100%; height: 100%; object-fit: cover; }
  .intro-asociacion .prose > h1:first-child { margin-top: 0; }
  @media (min-width: 56rem) {
    .two-col.intro-asociacion { align-items: center; }
  }
</style>
